# Nestora — copy the variables you use into the host's environment.
# Do not commit real passwords. Nothing in this file is loaded automatically.

DATABASE_URL=
DIRECT_URL=

# The only email that is created as an admin. Everyone else signs up as a guest or a host.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Nestora

# 32-byte key for encrypting Stripe and SMTP secrets saved in the admin dashboard.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Stripe. Dashboard settings override these. The secret and webhook secret stay on the server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloudinary. Leave empty to use S3, or inline image storage when neither is set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage (optional). Set STORAGE_DRIVER=s3 to force it.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=

# SMTP. Dashboard settings override these. Used when the dashboard fields are empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=TLS
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Nestora
SMTP_FROM=

# Optional Mapbox public token for the pin preview. OpenStreetMap is used when this is empty.
VITE_MAPBOX_TOKEN=
