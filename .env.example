# Nestora — copy the variables you use into the host's environment.
# Do not commit real passwords. Nothing in this file is loaded automatically.

# Runtime connection. A pooler is fine.
# Supabase transaction pooler (port 6543), for example:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# Your own VPS (port 5432). On a VPS, DATABASE_URL and DIRECT_URL can be the same URL:
# DATABASE_URL=postgresql://nestora:PASSWORD@127.0.0.1:5432/nestora
DATABASE_URL=

# Direct/session connection, port 5432. Used ONLY to create and update tables.
# Supabase direct host (not the pooler):
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# VPS — same value as DATABASE_URL:
# DIRECT_URL=postgresql://nestora:PASSWORD@127.0.0.1:5432/nestora
DIRECT_URL=

# The only email that can be an operator. Everyone else signs up as a guest.
# The first account is never promoted.
ADMIN_EMAIL=
# Used by `npm run db:setup` to create that operator if the account does not exist yet.
# At least 8 characters. Leave blank to promote the address only after they sign up.
ADMIN_PASSWORD=
ADMIN_NAME=Nestora operator

# Stripe. The secret and webhook secret stay on the server. The publishable key is public.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# Cloudinary. Files are not stored in Supabase.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend. If these are empty, messages are recorded and not sent.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Mapbox public token for the pin preview. OpenStreetMap is used when this is empty.
VITE_MAPBOX_TOKEN=
